#include <opencv2/opencv.hpp>
#include <iostream>
#include <vector>

int main() {
    cv::VideoCapture cap("Resources/demo.avi");
    if (!cap.isOpened()) {
        return -1;
    }

    int frame_width = static_cast<int>(cap.get(cv::CAP_PROP_FRAME_WIDTH));
    int frame_height = static_cast<int>(cap.get(cv::CAP_PROP_FRAME_HEIGHT));
    double fps = cap.get(cv::CAP_PROP_FPS);
    if (fps <= 0) fps = 30.0;

    cv::VideoWriter output_video(
        "output.mp4",
        cv::VideoWriter::fourcc('m', 'p', '4', 'v'),
        fps,
        cv::Size(frame_width, frame_height)
    );

    if (!output_video.isOpened()) {
        return -1;
    }

    cv::Mat frame, hsv, mask;
    while (cap.read(frame)) {
        if (frame.empty()) break;

        cv::cvtColor(frame, hsv, cv::COLOR_BGR2HSV);

        cv::Scalar lower_blue(90, 50, 130);
        cv::Scalar upper_blue(130, 255, 255);
        cv::inRange(hsv, lower_blue, upper_blue, mask);

        cv::Mat element = cv::getStructuringElement(cv::MORPH_RECT, cv::Size(3, 3));
        cv::morphologyEx(mask, mask, cv::MORPH_CLOSE, element);

        std::vector<std::vector<cv::Point>> contours;
        std::vector<cv::Vec4i> hierarchy;
        cv::findContours(mask, contours, hierarchy, cv::RETR_CCOMP, cv::CHAIN_APPROX_SIMPLE);

        for (size_t i = 0; i < contours.size(); ++i) {
            if (hierarchy[i][3] >= 0) {
                double area = cv::contourArea(contours[i]);
                if (area < 10) continue;

                cv::Rect black_rect = cv::boundingRect(contours[i]);
                double aspect_ratio = (double)black_rect.height / black_rect.width;

                if (aspect_ratio > 1.0 && black_rect.height > 10 && black_rect.height < 300) {
                    cv::rectangle(frame, black_rect, cv::Scalar(0, 255, 0), 3);
                }
            }
        }

        output_video.write(frame);

        cv::imshow("Result", frame);
        if (cv::waitKey(30) == 27) break;
    }

    cap.release();
    output_video.release();
    cv::destroyAllWindows();
    return 0;
}
